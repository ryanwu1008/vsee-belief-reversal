# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
# For Cloudflare Workers, use Atlas's standard seed-list connection string
# rather than mongodb+srv so the runtime does not need DNS SRV resolution.
MONGODB_URI=mongodb://APP_USER:APP_PASSWORD@HOST_00:27017,HOST_01:27017,HOST_02:27017/?tls=true&authSource=admin&replicaSet=REPLICA_SET&retryWrites=true&w=majority&appName=VSeeContextLoop
MONGODB_DB=vsee_context_loop

# Explicit local/test fallback only. Production should leave this unset.
# CONTEXT_LOOP_USE_FIXTURE=true
